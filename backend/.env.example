# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
# Default local MongoDB:
MONGODB_URI=mongodb://localhost:27017/maxhousekeeping
# MongoDB Atlas Connection (uncomment and replace with your URI):
# MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/maxhousekeeping?retryWrites=true&w=majority

# JWT Secret for Authentication
JWT_SECRET=max_housekeeping_super_secret_jwt_key_2026
JWT_EXPIRE=7d

# Email Automation (Gmail App Password)
# Enter your Gmail address and 16-character App Password from Google Account > Security > App Passwords
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password
ADMIN_EMAIL=admin@maxhousekeepingservice.com

# Cloudinary Image Upload
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
