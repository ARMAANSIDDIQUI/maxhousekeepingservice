{
  "name": "maxhousekeeping-backend",
  "version": "1.0.0",
  "description": "Backend API for Max Housekeeping Service",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "seed:media": "node scripts/upload-media.js",
    "seed:all": "node scripts/upload-media.js && node scripts/seed.js",
