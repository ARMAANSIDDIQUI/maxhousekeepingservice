    "make-admin": "node scripts/makeAdmin.js",
    "test:pricing": "node scripts/testPricing.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.0",
